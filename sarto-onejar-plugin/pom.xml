<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-onejar</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- jar packaging for now; becomes maven-plugin packaging with the first mojo. -->
    <artifactId>sarto-onejar-plugin</artifactId>
    <name>Sarto OneJar Plugin</name>
    <description>Target index generation and TeaVM pruning for unified JVM and TeaVM JARs</description>

    <dependencies>
        <dependency>
            <groupId>io.instanto</groupId>
            <artifactId>sarto-onejar-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-extension-spi</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.testing.compile</groupId>
            <artifactId>compile-testing</artifactId>
            <version>${compile-testing.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration><proc>none</proc></configuration>
            </plugin>
        </plugins>
    </build>
</project>
